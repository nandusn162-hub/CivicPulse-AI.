# CivicPulse AI – Environment Variables (example)
# Copy this file to .env and fill in the values.

# -------------------------------------------------
# Database
# -------------------------------------------------
# Async URL for SQLAlchemy (used by FastAPI)
DATABASE_URL=postgresql+asyncpg://civicpulse:password@localhost:5432/civicpulse_db
# Synchronous URL for migrations / Alembic
DATABASE_URL_SYNC=postgresql://civicpulse:password@localhost:5432/civicpulse_db

# -------------------------------------------------
# Security / Auth
# -------------------------------------------------
SECRET_KEY=change-me-to-a-32-byte-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------
# Google Gemini AI (optional – demo mode works without it)
# -------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# -------------------------------------------------
# File storage – local fallback or Supabase
# -------------------------------------------------
STORAGE_PROVIDER=local   # or "supabase"
STORAGE_LOCAL_PATH=./uploads
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=civicpulse-evidence

# -------------------------------------------------
# Weather API (optional)
# -------------------------------------------------
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# -------------------------------------------------
# Application settings
# -------------------------------------------------
APP_NAME=CivicPulse AI
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
API_PREFIX=/api/v1

# -------------------------------------------------
# Rate limiting & uploads
# -------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
UPLOAD_MAX_SIZE_MB=10

# -------------------------------------------------
# Super admin for demo
# -------------------------------------------------
SUPER_ADMIN_EMAIL=admin@civicpulse.ai
SUPER_ADMIN_PASSWORD=CivicAdmin123!

# -------------------------------------------------
# Demo mode flag – shows placeholder AI results when GEMINI_API_KEY missing
# -------------------------------------------------
DEMO_MODE=true
DEMO_CITY=Whitefield Demo City
